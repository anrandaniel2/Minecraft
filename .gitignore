# Godot
.godot/
*.import
android/build/
android/.build_version
export/

# Intermediate build products. NOTE: bin/**/*.so are intentionally tracked:
# CI builds them and commits them back so a plain checkout can be exported
# without an NDK (Godot never compiles C++ during export).
*.os
*.o
*.a
godot-cpp/bin/
.sconsign.dblite
.sconf_temp/
__pycache__/

# Local secrets
*.keystore
!debug.keystore.example
thirdparty/brotli/**/*.o
