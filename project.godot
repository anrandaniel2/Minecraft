; Engine configuration for Blockcraft.
;
; Note: the input map is built in code (scripts/core/input_setup.gd) so that
; keyboard, mouse, gamepad and touch bindings stay in one reviewable place and
; can be remapped at runtime by the settings menu.

config_version=5

[application]

config/name="Blockcraft"
config/description="An open-world voxel sandbox: survival, building, redstone and multiplayer."
config/version="1.0.1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/generated/ui/logo.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.09, 0.11, 0.14, 1)
boot_splash/show_image=false

[autoload]

GameLog="*res://scripts/core/game_log.gd"
Settings="*res://scripts/core/settings.gd"
Registry="*res://scripts/core/registry.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
SaveManager="*res://scripts/core/save_manager.gd"
MpManager="*res://scripts/net/multiplayer_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

[internationalization]

locale/fallback="en"

[physics]

3d/default_gravity=26.0

[rendering]

; Compatibility renderer (OpenGL ES 3 on Android) everywhere.
;
; It is the backend with the widest driver support in the engine and the only
; one that needs no Vulkan driver on the device at all, which is what this game
; has to survive on: a phone that is not ours, with a driver that may be years
; old or half-implemented. Everything the game draws is supported here (chunk
; meshes, the atlas shaders, the unshaded sky dome and particles); the features
; it cannot do - SDFGI, SSAO, screen-space reflections, volumetric fog, compute
; - are all switched off anyway.
;
; To go back to Vulkan, set both lines below to "mobile". Whichever one is
; active is printed at boot ("Blockcraft: renderer=... workers=... - menu
; ready") and under the main menu title, so a phone screenshot says which.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Android needs ETC2/ASTC; desktop keeps its smaller formats.
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/use_nearest_mipmap_filter=true
environment/defaults/default_clear_color=Color(0.35, 0.55, 0.85, 1)

[threading]

; -1 is the engine default: one worker per logical core. 0 does NOT mean "auto".
; WorkerThreadPool::init() treats any negative count as auto and resizes the
; pool to the literal value otherwise, so 0 leaves an exported game with no
; worker threads at all: chunk generation, meshing and Vulkan shader compilation
; then all run inline on the main thread, the game freezes for long enough on a
; phone, and Android kills it as "not responding".
worker_pool/max_threads=-1
