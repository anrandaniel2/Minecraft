config_version=5

[application]
name="Eaglercraft Native - Godot C++ Port"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.090, 0.118, 0.151, 1)

[autoload]
