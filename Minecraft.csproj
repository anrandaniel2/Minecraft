<Project Sdk="Godot.NET.Sdk/4.4.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Minecraft</RootNamespace>
    <AssemblyName>Minecraft</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scripts/AutoGenerated is a decompiled-reference dump. It duplicates real game
         classes (Hud, TitleScreen, Button, ...) and breaks the build with CS0101/CS0260.
         It is kept in the repo as reference only (see Scripts/AutoGenerated/.gdignore). -->
    <Compile Remove="Scripts/AutoGenerated/**" />
  </ItemGroup>
</Project>
