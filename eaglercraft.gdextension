[configuration]
entry_symbol = "gdext_library_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libeaglercraft.linux.debug.x86_64.so"
linux.release.x86_64 = "res://bin/libeaglercraft.linux.release.x86_64.so"
windows.debug.x86_64 = "res://bin/libeaglercraft.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libeaglercraft.windows.release.x86_64.dll"
macos.debug = "res://bin/libeaglercraft.macos.debug.framework"
macos.release = "res://bin/libeaglercraft.macos.release.framework"
