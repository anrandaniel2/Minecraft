[configuration]

entry_symbol = "eaglerhost_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

android.debug.arm64 = "res://bin/android/libeaglerhost.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libeaglerhost.android.template_release.arm64.so"
android.debug.arm32 = "res://bin/android/libeaglerhost.android.template_debug.arm32.so"
android.release.arm32 = "res://bin/android/libeaglerhost.android.template_release.arm32.so"
; Editor-only stub so the project opens on a desktop without errors (optional build).
linux.debug.x86_64 = "res://bin/linux/libeaglerhost.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libeaglerhost.linux.template_release.x86_64.so"
