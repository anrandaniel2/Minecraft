#!/usr/bin/env python
import os
import sys

env = SConscript("godot-cpp/SConstruct")

# Add our src paths for existing engine
env.Append(CPPPATH=["src/", "../src/", "../src/core", "../src/world", "../src/player", "../src/rendering", "../src/ui", "../src/utils", "godot-cpp/include", "godot-cpp/gen/include"])

# Collect sources - GDExtension C++ files
sources = Glob("src/*.cpp")

# We do NOT include ../src/ directly to avoid conflicts, but we link the logic
# Instead, our GDExtension re-implements the same logic in Godot style (pure C++)

# Defines for Vulkan
env.Append(CPPDEFINES=["EAGLER_VULKAN=1", "EAGLER_GODOT=1", "EAGLER_ANDROID=1"])

# Godot 4 uses Vulkan by default, so no extra libs needed
# For Android, we need to ensure we build for arm64-v8a

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libeaglercraft.{}.{}.framework/libeaglercraft.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libeaglercraft{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
